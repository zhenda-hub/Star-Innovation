---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="页面未找到" description="抱歉，你访问的页面不存在。">
  <section class="container-site grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="text-7xl font-black text-brand/20">404</p>
      <h1 class="mt-4 text-2xl font-bold text-ink-strong">页面未找到</h1>
      <p class="mt-3 text-muted">你访问的页面可能已被移动或不存在。</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn btn-primary">
          <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
          返回首页
        </a>
        <a href="/contact/" class="btn btn-ghost">联系我们</a>
      </div>
    </div>
  </section>
</Layout>
